# agy-mcp-server configuration
#
# Copy to `.env` next to package.json (or point AGY_MCP_ENV_FILE at it).
# Values already present in the environment win over this file.
#
# Units: plain seconds ("900") or suffixes ("15m", "2h").

# --- server identity -------------------------------------------------------
AGY_MCP_NAME=agy

# --- agy binary ------------------------------------------------------------
# Default: `agy` from $PATH, then ~/.local/bin/agy
# AGY_BIN=/root/.local/bin/agy

# --- conversation defaults -------------------------------------------------
# AGY_WORKSPACE=/path/to/workspace
# AGY_MODEL=gemini-3.8-flash-high
# AGY_EFFORT=high
# AGY_MODE=accept-edits
# AGY_AGENT=

# --- permissions handed to agy via --settings ------------------------------
# Rule syntax: command(git), command(git log), command(*), mcp(*)
# There is no glob support.
AGY_ALLOW=command(*),mcp(*)
AGY_DENY=
AGY_SKIP_PERMISSIONS=0

# --- timeouts --------------------------------------------------------------
# per-turn limit (per-call `timeout` overrides this)
AGY_ASK_TIMEOUT=900
# how long a second agy_ask waits for a busy conversation
AGY_BUSY_TIMEOUT=120
# close idle agent processes after this long (memory stays resumable)
AGY_IDLE_TTL=1800
# max simultaneously live conversation processes (idle LRU are closed)
AGY_MAX_CONVERSATIONS=8

# --- streaming -------------------------------------------------------------
# Stream agent text deltas to the host as MCP progress notifications.
AGY_MCP_PROGRESS=1

# --- auth token (used by agy_status) --------------------------------------
# AGY_TOKEN_FILE=~/.gemini/antigravity-cli/antigravity-oauth-token
